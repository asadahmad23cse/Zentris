{
  "name": "zentris",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade AI security middleware",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test src/tests/*.test.ts",
    "test:integration": "tsx --test src/tests/integration.test.ts",
    "audit:prod": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/sinon": "^17.0.4",
    "sinon": "^19.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
