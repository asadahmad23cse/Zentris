{
  "version": 1,
  "rules": [
    { "id": "anthropic_api_key", "type": "ANTHROPIC_KEY", "category": "credential", "pattern": "\\bsk-ant-(?:api\\d{2}-)?[A-Za-z0-9_-]{40,}\\b", "flags": "g" },
    { "id": "openai_api_key", "type": "OPENAI_KEY", "category": "credential", "pattern": "\\bsk-(?:(?:proj|svcacct)-)?[A-Za-z0-9_-]{20,}\\b", "flags": "g" },
    { "id": "google_api_key", "type": "GOOGLE_API_KEY", "category": "credential", "pattern": "\\bAIza[A-Za-z0-9_-]{35}\\b", "flags": "g" },
    { "id": "aws_access_key", "type": "AWS_ACCESS_KEY", "category": "credential", "pattern": "\\b(?:AKIA|ASIA)[A-Z0-9]{16}\\b", "flags": "g" },
    { "id": "aws_secret", "type": "AWS_SECRET_KEY", "category": "credential", "pattern": "\\baws(?:_access)?_secret(?:_key)?\\s*[:=]\\s*[\"']?[A-Za-z0-9/+=]{40}[\"']?", "flags": "gi" },
    { "id": "github_token", "type": "GITHUB_TOKEN", "category": "credential", "pattern": "\\b(?:gh[pousr]_[A-Za-z0-9]{36,255}|github_pat_[A-Za-z0-9_]{50,255})\\b", "flags": "g" },
    { "id": "gitlab_token", "type": "GITLAB_TOKEN", "category": "credential", "pattern": "\\bglpat-[A-Za-z0-9_-]{20,}\\b", "flags": "g" },
    { "id": "slack_token", "type": "SLACK_TOKEN", "category": "credential", "pattern": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b", "flags": "g" },
    { "id": "slack_webhook", "type": "SLACK_WEBHOOK", "category": "credential", "pattern": "https://hooks\\.slack\\.com/services/[A-Za-z0-9/_-]{20,}", "flags": "g" },
    { "id": "stripe_key", "type": "STRIPE_KEY", "category": "credential", "pattern": "\\b(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,}\\b", "flags": "g" },
    { "id": "huggingface_token", "type": "HUGGINGFACE_TOKEN", "category": "credential", "pattern": "\\bhf_[A-Za-z0-9]{20,}\\b", "flags": "g" },
    { "id": "npm_token", "type": "NPM_TOKEN", "category": "credential", "pattern": "\\bnpm_[A-Za-z0-9]{30,}\\b", "flags": "g" },
    { "id": "twilio_key", "type": "TWILIO_KEY", "category": "credential", "pattern": "\\bSK[0-9a-fA-F]{32}\\b", "flags": "g" },
    { "id": "sendgrid_key", "type": "SENDGRID_KEY", "category": "credential", "pattern": "\\bSG\\.[A-Za-z0-9_-]{16,}\\.[A-Za-z0-9_-]{20,}\\b", "flags": "g" },
    { "id": "azure_sas", "type": "AZURE_SAS_TOKEN", "category": "credential", "pattern": "(?:^|[?&])sv=\\d{4}-\\d{2}-\\d{2}&[A-Za-z0-9%&=._~-]{20,}\\bsig=[A-Za-z0-9%+/=]+", "flags": "gi" },
    { "id": "jwt", "type": "JWT_TOKEN", "category": "credential", "pattern": "\\beyJ[A-Za-z0-9_-]{5,}\\.[A-Za-z0-9_-]{5,}\\.[A-Za-z0-9_-]{5,}\\b", "flags": "g" },
    { "id": "private_key", "type": "PRIVATE_KEY", "category": "credential", "pattern": "-----BEGIN (?:RSA |EC |OPENSSH |DSA |ENCRYPTED )?PRIVATE KEY-----[\\s\\S]{16,}?-----END (?:RSA |EC |OPENSSH |DSA |ENCRYPTED )?PRIVATE KEY-----", "flags": "g" },
    { "id": "database_url", "type": "DATABASE_URL", "category": "credential", "pattern": "\\b(?:postgres(?:ql)?|mysql|mariadb|mongodb(?:\\+srv)?|redis|rediss|mssql|oracle)://[^\\s'\"`]+", "flags": "gi" },
    { "id": "basic_auth", "type": "BASIC_AUTH", "category": "credential", "pattern": "\\bBasic\\s+[A-Za-z0-9+/=]{12,}\\b", "flags": "g" },
    { "id": "bearer_token", "type": "BEARER_TOKEN", "category": "credential", "pattern": "\\bBearer\\s+[A-Za-z0-9._~+/-]{16,}={0,2}\\b", "flags": "gi" },
    { "id": "contextual_secret", "type": "CONTEXTUAL_SECRET", "category": "credential", "pattern": "\\b(?:api[_ -]?key|api[_ -]?secret|client[_ -]?secret|access[_ -]?token|auth[_ -]?token|refresh[_ -]?token|secret[_ -]?key|password|passwd|pwd)\\b\\s*[:=]\\s*[\"']?[^\\s,\"';]{8,}[\"']?", "flags": "gi" },
    { "id": "encoded_base64_secret", "type": "ENCODED_SECRET", "category": "credential", "pattern": "\\b[A-Za-z0-9+/]{32,4096}={0,2}\\b", "flags": "g", "validator": "encoded_secret" },
    { "id": "encoded_hex_secret", "type": "ENCODED_SECRET", "category": "credential", "pattern": "\\b(?:[0-9A-Fa-f]{2}){16,2048}\\b", "flags": "g", "validator": "encoded_secret" },

    { "id": "email", "type": "EMAIL", "category": "personal", "pattern": "\\b[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+\\b", "flags": "g" },
    { "id": "ssn", "type": "US_SSN", "category": "personal", "pattern": "\\b(?!000|666|9\\d\\d)\\d{3}[- ](?!00)\\d{2}[- ](?!0000)\\d{4}\\b", "flags": "g" },
    { "id": "global_phone", "type": "PHONE", "category": "personal", "pattern": "(?:\\+\\d{1,3}[ .-]?(?:\\(?\\d{2,4}\\)?[ .-]?){2,4}\\d{3,4}|\\b(?:\\(?\\d{2,4}\\)?[ .-]?){2,4}\\d{3,4})\\b", "flags": "g" },
    { "id": "payment_card", "type": "PAYMENT_CARD", "category": "financial", "pattern": "\\b(?:\\d[ -]?){13,19}\\b", "flags": "g", "validator": "luhn" },
    { "id": "iban", "type": "IBAN", "category": "financial", "pattern": "\\b[A-Z]{2}\\d{2}(?:[ ]?[A-Z0-9]){11,30}\\b", "flags": "g", "validator": "iban" },
    { "id": "swift_bic", "type": "SWIFT_BIC", "category": "financial", "pattern": "\\b(?:swift|bic)(?:\\s+code)?\\s*[:=#-]?\\s*[A-Z]{6}[A-Z0-9]{2}(?:[A-Z0-9]{3})?\\b", "flags": "gi" },
    { "id": "ipv4", "type": "IP_ADDRESS", "category": "network", "pattern": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b", "flags": "g", "validator": "ip" },
    { "id": "ipv6", "type": "IP_ADDRESS", "category": "network", "pattern": "\\b(?:[A-Fa-f0-9]{1,4}:){2,7}[A-Fa-f0-9]{0,4}\\b", "flags": "g", "validator": "ip" },
    { "id": "mac_address", "type": "MAC_ADDRESS", "category": "network", "pattern": "\\b(?:[0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}\\b", "flags": "g" },
    { "id": "date_of_birth", "type": "DATE_OF_BIRTH", "category": "personal", "pattern": "\\b(?:dob|date\\s+of\\s+birth|birthdate)\\s*[:=]?\\s*(?:\\d{1,2}[/-]\\d{1,2}[/-]\\d{2,4}|\\d{4}-\\d{2}-\\d{2}|[A-Za-z]{3,9}\\s+\\d{1,2},?\\s+\\d{4})\\b", "flags": "gi", "validator": "date" },
    { "id": "passport_context", "type": "PASSPORT_NUMBER", "category": "personal", "pattern": "\\bpassport(?:\\s+(?:no|number))?\\s*[:=#-]?\\s*[A-Z0-9]{6,12}\\b", "flags": "gi" },
    { "id": "driver_license_context", "type": "DRIVER_LICENSE", "category": "personal", "pattern": "\\b(?:driver'?s?\\s+licen[cs]e|driving\\s+licen[cs]e|dl\\s+number)\\s*[:=#-]?\\s*[A-Z0-9 -]{6,20}\\b", "flags": "gi" },
    { "id": "medical_id_context", "type": "MEDICAL_IDENTIFIER", "category": "health", "pattern": "\\b(?:medical\\s+record|patient\\s+id|health\\s+id|insurance\\s+member)\\s*[:=#-]?\\s*[A-Z0-9_-]{5,24}\\b", "flags": "gi" },
    { "id": "address_context", "type": "POSTAL_ADDRESS", "category": "personal", "pattern": "\\b(?:address|resides?\\s+at|home\\s+address)\\s*[:=]\\s*[^\\n;]{8,160}", "flags": "gi" },
    { "id": "name_context", "type": "PERSON_NAME", "category": "personal", "pattern": "\\b(?:full\\s+name|legal\\s+name|patient\\s+name)\\s*[:=]\\s*[\\p{L}][\\p{L} .'-]{2,80}", "flags": "giu" },

    { "id": "india_aadhaar", "type": "INDIA_AADHAAR", "category": "personal", "pattern": "\\b[2-9]\\d{3}[ -]?\\d{4}[ -]?\\d{4}\\b", "flags": "g", "validator": "aadhaar" },
    { "id": "india_pan", "type": "INDIA_PAN", "category": "financial", "pattern": "\\b[A-Z]{5}\\d{4}[A-Z]\\b", "flags": "g" },
    { "id": "india_gstin", "type": "INDIA_GSTIN", "category": "financial", "pattern": "\\b\\d{2}[A-Z]{5}\\d{4}[A-Z][1-9A-Z]Z[0-9A-Z]\\b", "flags": "g" },
    { "id": "india_epic", "type": "INDIA_VOTER_ID", "category": "personal", "pattern": "\\b[A-Z]{3}\\d{7}\\b", "flags": "g" },
    { "id": "india_passport", "type": "INDIA_PASSPORT", "category": "personal", "pattern": "\\b[A-Z][1-9]\\d{6}\\b", "flags": "g" },
    { "id": "india_driving_license", "type": "INDIA_DRIVING_LICENSE", "category": "personal", "pattern": "\\b[A-Z]{2}[ -]?\\d{2}[ -]?(?:19|20)?\\d{2}[ -]?\\d{7}\\b", "flags": "g" },
    { "id": "india_upi", "type": "INDIA_UPI_ID", "category": "financial", "pattern": "\\b[A-Za-z0-9._-]{2,}@[A-Za-z][A-Za-z0-9.-]{1,}\\b", "flags": "g" },
    { "id": "india_ifsc", "type": "INDIA_IFSC", "category": "financial", "pattern": "\\b[A-Z]{4}0[A-Z0-9]{6}\\b", "flags": "g" },
    { "id": "india_bank_context", "type": "INDIA_BANK_ACCOUNT", "category": "financial", "pattern": "\\b(?:account|a/c)(?:\\s+(?:no|number))?\\s*[:=#-]?\\s*\\d{9,18}\\b", "flags": "gi" }
  ]
}
