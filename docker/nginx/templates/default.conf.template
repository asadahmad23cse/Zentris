upstream gateway_upstream {
    zone gateway_upstream 64k;
    least_conn;
    server gateway:3000 resolve;
}

upstream dashboard_upstream {
    zone dashboard_upstream 64k;
    least_conn;
    server dashboard:3000 resolve;
}

# Docker's embedded DNS tracks service IPs across container recreation.
resolver 127.0.0.11 valid=5s ipv6=off;

server {
    listen 80;
    server_name _;

    # Security headers
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' http: https: ws: wss:; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Frame-Options "DENY" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    # All API and management traffic passes through the Zentris gateway.
    location ~ ^/(v1|v2|v3|key|team|user|model|health|metrics|compliance|chat|embeddings|responses|audio|image|moderations|assistants|threads|files|fine_tuning|batches|organization|project|guardrails|spend|budget|global|sso|public|\.well-known)(/|$) {
        proxy_pass http://gateway_upstream;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }

    # Dashboard routes
    location / {
        proxy_pass http://dashboard_upstream;
        proxy_read_timeout 300s;
    }
}
