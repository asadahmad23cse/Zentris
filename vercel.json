{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "ui/litellm-dashboard/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/ui$",
      "dest": "ui/litellm-dashboard/"
    },
    {
      "src": "/ui/(.*)",
      "dest": "ui/litellm-dashboard/$1"
    },
    {
      "src": "/(.*)",
      "dest": "ui/litellm-dashboard/$1"
    }
  ]
}
