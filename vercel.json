{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "github": { "silent": true },
  "installCommand": "npm install next@16.3.1 --no-save --legacy-peer-deps && cd ui/litellm-dashboard && npm ci",
  "buildCommand": "cd ui/litellm-dashboard && npm run build",
  "outputDirectory": "ui/litellm-dashboard/.next",
  "framework": "nextjs",
  "rewrites": [
    { "source": "/ui", "destination": "/" },
    { "source": "/ui/:path*", "destination": "/:path*" },
    { "source": "/:path*", "destination": "https://zentris-api.onrender.com/:path*" }
  ]
}
